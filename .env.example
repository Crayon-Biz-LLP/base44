# Copy to .env.local and fill in. `.env.local` is gitignored — never commit real secrets.
#
# ── Required ────────────────────────────────────────────────────────────────
# Postgres (Neon) connection string, read by the app and by drizzle-kit.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# HMAC secret used to sign owner/staff session cookies.
# REQUIRED in production: the app refuses to sign or verify sessions without it.
# In development an insecure fallback is used and a warning is logged.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Google Generative AI key(s) for extraction/repair (Vercel AI SDK).
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional extra keys for rotation / spreading load:
# GOOGLE_GENERATIVE_AI_API_KEY_2=
# GOOGLE_GENERATIVE_AI_API_KEY_3=

# Public base URL of the deployment (used in links/callbacks).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
# Shared secret guarding the /api/cron/* endpoints.
# CRON_SECRET=

# Email alerts (Resend).
# RESEND_API_KEY=
# ALERT_FROM_EMAIL=

# WhatsApp alerts.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Debug / feature flags.
# AI_STRUCTURED_OUTPUTS=1
# ARTIFACT_ROLLS=
# REPAIR_DEBUG=1
