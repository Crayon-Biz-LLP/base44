{
  "name": "ops-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:prompts": "node tests/regression.mjs",
    "test:dashboards": "node tests/dashboard-regression.mjs",
    "test:unit": "tsx tests/manifest-v5.mts && tsx tests/artifact-enrich.mts && tsx tests/guardrails-v5.mts",
    "test:zero-llm": "tsx tests/owner-edit.mts && tsx tests/validate-artifact.mts && tsx tests/config-evolution.mts && tsx tests/archetypes.mts && tsx tests/new-archetypes.mts && tsx tests/console-emission.mts && tsx tests/fleet.mts",
    "migrate:v5": "tsx scripts/migrate-v5.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "backfill:app": "tsx scripts/backfill-app.mts",
    "sweep:guardrails": "tsx scripts/guardrail-sweep.mts",
    "test:renderer": "tsx tests/renderer.mts",
    "test:e2e": "tsx tests/e2e-v5.mts",
    "seed:behavior": "tsx scripts/seed-behavior.mts",
    "test:behavior": "tsx scripts/seed-behavior.mts && tsx tests/behavior-all.mts",
    "test:all": "npm run test:unit && npm run test:zero-llm && npm run test:renderer && npm run test:dashboards && npm run test:behavior"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.67",
    "@ai-sdk/react": "^4.0.100",
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.97",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.45.0",
    "mathjs": "^15.2.0",
    "next": "16.3.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.30.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
